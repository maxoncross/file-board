{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FileBoard",
  "version": "0.1.0",
  "identifier": "com.fileboard.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FileBoard",
        "width": 1200,
        "height": 780,
        "minWidth": 480,
        "minHeight": 320,
        "dragDropEnabled": true,
        "backgroundColor": "#16171b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "maxoncross",
    "copyright": "© 2026 maxoncross. MIT License.",
    "category": "Productivity",
    "shortDescription": "Доска для файлов, папок, ссылок и заметок",
    "longDescription": "FileBoard — свободная доска для Windows: складывайте файлы, папки, ярлыки, ссылки и заметки и открывайте их в один клик. Встроенная панель-проводник слева.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  }
}
